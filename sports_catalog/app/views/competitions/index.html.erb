<div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-extrabold text-gray-900">Sports Competitions</h1>
  <div class="space-x-3">
    <% if action_name == 'upcoming' %>
      <%= link_to "Show All", competitions_path, class: "px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg shadow-sm hover:bg-gray-50 transition font-medium" %>
    <% else %>
      <%= link_to "Show Upcoming Only", upcoming_competitions_path, class: "px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg shadow-sm hover:bg-gray-50 transition font-medium" %>
    <% end %>
    
    <%= link_to "+ Create New", new_competition_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg shadow-sm hover:bg-indigo-700 transition font-medium" %>
  </div>
</div>

<% if @competitions.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @competitions.each do |competition| %>
      <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-lg transition">
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-900 mb-3 truncate"><%= competition.title %></h3>
          
          <div class="space-y-2 mb-6">
            <p class="text-gray-600 flex justify-between">
              <span class="font-medium text-gray-500">Location:</span> 
              <span class="font-semibold text-gray-800"><%= competition.location_name || "TBD" %></span>
            </p>
            <p class="text-gray-600 flex justify-between items-center">
              <span class="font-medium text-gray-500">Status:</span>
              <%= status_badge(competition.status) %>
            </p>
          </div>
          
          <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
            <%= link_to "Show details", competition, class: "text-indigo-600 hover:text-indigo-900 font-semibold text-sm" %>
            
            <div class="flex space-x-3 text-sm">
              <%= link_to "Edit", edit_competition_path(competition), class: "text-gray-500 hover:text-gray-800" %>
              <%= button_to "Delete", competition, method: :delete, form: { data: { turbo_confirm: 'Are you sure?' } }, class: "text-red-500 hover:text-red-700" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center mt-6">
    <div class="text-6xl mb-4">🤷‍♂️</div> 
    
    <% if action_name == 'upcoming' %>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No upcoming competitions</h3>
      <p class="text-gray-500 mb-6">There are currently no sports events scheduled for the future.</p>
      <%= link_to "View all competitions", competitions_path, class: "text-indigo-600 hover:text-indigo-800 font-medium underline" %>
    <% else %>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No competitions found</h3>
      <p class="text-gray-500 mb-6">You haven't added any sports competitions yet.</p>
      <%= link_to "+ Create your first competition", new_competition_path, class: "inline-block px-6 py-3 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition font-medium" %>
    <% end %>
  </div>
<% end %>