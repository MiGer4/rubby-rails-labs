<div class="bg-white rounded-xl shadow-lg overflow-hidden max-w-4xl mx-auto border border-gray-100">
  <div class="bg-gradient-to-r from-indigo-600 to-blue-500 px-8 py-6">
    <h1 class="text-3xl font-bold text-white"><%= @competition.title %></h1>
  </div>

  <div class="p-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <div class="space-y-4">
        <p class="text-gray-600"><span class="block text-sm font-medium text-gray-400 uppercase tracking-wider">Location</span> 
          <span class="text-lg font-semibold text-gray-900"><%= @competition.location_name %></span>
        </p>
        <div>
          <span class="block text-sm font-medium text-gray-400 uppercase tracking-wider mb-1">Status</span>
          <%= status_badge(@competition.status) %>
          <p class="text-gray-600"><span class="block text-sm font-medium text-gray-400 uppercase tracking-wider">Author</span> 
            <span class="text-lg font-semibold text-gray-900"><%= @competition.user.email %></span>
          </p>
        </div>
      </div>
      <div class="space-y-4">
        <p class="text-gray-600"><span class="block text-sm font-medium text-gray-400 uppercase tracking-wider">Start date</span> 
          <span class="text-lg font-semibold text-gray-900"><%= @competition.start_date %></span>
        </p>
        <p class="text-gray-600"><span class="block text-sm font-medium text-gray-400 uppercase tracking-wider">Prize fund</span> 
          <span class="text-lg font-bold text-green-600">$<%= @competition.prize_fund %></span>
        </p>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-8 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">Sports Categories</h3>
        <% if @competition.sports.any? %>
          <div class="flex flex-wrap gap-2">
            <% @competition.sports.each do |sport| %>
              <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-md text-sm font-medium"><%= sport.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 italic">No sports categories added yet.</p>
        <% end %>
      </div>

      <div>
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">Participating Teams</h3>
        <% if @competition.teams.any? %>
          <div class="flex flex-wrap gap-2">
            <% @competition.teams.each do |team| %>
              <span class="bg-blue-50 text-blue-700 border border-blue-200 px-3 py-1 rounded-md text-sm font-medium"><%= team.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 italic">No teams added yet.</p>
        <% end %>
      </div>

      <div>
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">Tags</h3>
        <% if @competition.tags.any? %>
          <div class="flex flex-wrap gap-2">
            <% @competition.tags.each do |tag| %>
              <%= tag_badge(tag.name) %>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 italic">No tags added yet.</p>
        <% end %>
      </div>
    </div>

    <% if @competition.description.present? %>
      <div class="mt-8 pt-8 border-t border-gray-100">
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">About this competition</h3>
        <div class="text-gray-700 leading-relaxed bg-gray-50 p-6 rounded-lg border border-gray-200 shadow-inner">
          <%# simple_format зберігає твої Enter-и з форми і робить абзаци %>
          <%= simple_format(@competition.description) %>
        </div>
      </div>
    <% end %>

    <div class="mt-8 pt-8 border-t border-gray-100">
      <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">Collaborators</h3>
      
      <% if @competition.collaborators.any? %>
        <ul class="mb-4 flex flex-wrap gap-2">
          <% @competition.collaborators.each do |collaborator| %>
            <li class="inline-flex items-center bg-gray-100 px-3 py-1.5 rounded-full text-sm font-medium text-gray-800">
              <svg class="w-4 h-4 mr-1.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path></svg>
              <%= collaborator.email %>
              
              <% if @competition.user == current_user %>
                <%= button_to remove_collaborator_competition_path(@competition, collaborator_id: collaborator.id), 
                              method: :delete, 
                              form: { class: "inline-block ml-2" },
                              class: "text-gray-400 hover:text-red-500 font-bold text-lg leading-none cursor-pointer transition focus:outline-none",
                              data: { turbo_confirm: "Remove #{collaborator.email} from collaborators?" } do %>
                  &times;
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500 italic mb-4 text-sm">No collaborators yet.</p>
      <% end %>

      <% if @competition.user == current_user %>
        <%= form_with url: add_collaborator_competition_path(@competition), method: :post, class: "flex items-center space-x-2" do |f| %>
          <%= f.email_field :email, list: "users_emails", placeholder: "Type or select email...", required: true, class: "rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 py-2 px-3 border text-sm w-64" %>
          <%= f.submit "Add", class: "px-4 py-2 bg-indigo-100 text-indigo-700 hover:bg-indigo-200 font-bold rounded-md transition cursor-pointer text-sm shadow-sm" %>
          
          <datalist id="users_emails">
            <% User.where.not(id: current_user.id).pluck(:email).each do |user_email| %>
              <option value="<%= user_email %>">
            <% end %>
          </datalist>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="bg-gray-50 px-8 py-5 flex space-x-4 border-t border-gray-100">
    <%= link_to "Edit this competition", edit_competition_path(@competition), class: "px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium shadow-sm" %>
    <%= link_to "Back to list", competitions_path, class: "px-5 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium shadow-sm" %>
  </div>
</div>